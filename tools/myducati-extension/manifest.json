{
  "manifest_version": 3,
  "name": "DMS Ducati — My Ducati et catalogue",
  "version": "0.10.0",
  "description": "Importe dans le DMS Ducati Bruxelles les infos d'une moto depuis My Ducati et le catalogue Ducati (modèles, vues éclatées, pièces) depuis l'e-catalog, avec la session de l'utilisateur.",
  "permissions": [
    "tabs",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://*.ducati.com/*",
    "https://*.my.site.com/*",
    "https://*.force.com/*",
    "https://*.documentforce.com/*",
    "https://*.netlify.app/*",
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.ducati.com/*",
        "https://*.my.site.com/*",
        "https://*.force.com/*"
      ],
      "js": [
        "ducati.js"
      ],
      "run_at": "document_idle",
      "exclude_matches": [
        "https://e-catalog.ducati.com/*"
      ]
    },
    {
      "matches": [
        "https://e-catalog.ducati.com/*"
      ],
      "js": [
        "catalog-core.js",
        "catalog.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.netlify.app/*",
        "http://localhost:8080/*"
      ],
      "js": [
        "dms-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "DMS Ducati — My Ducati et catalogue"
  }
}